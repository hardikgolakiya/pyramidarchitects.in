{
  "fonts": {
    "sans": {"family": "Familjen Grotesk", "weights": "400-700 variable", "variable": "--font-familjen-grotesk", "fallback": "Arial, size-adjust 94.59%, ascent 108.37%, descent 23.79%"},
    "serif": {"family": "Instrument Serif", "weights": [400], "styles": ["normal", "italic (loaded, unused)"], "variable": "--font-instrument-serif", "fallback": "Times New Roman, size-adjust 83.94%, ascent 117.94%, descent 36.93%"}
  },
  "colors": {
    "sand": "#EDE6D6", "ink": "#2A2725", "white": "#FFFFFF", "black": "#000000",
    "night": "#1c398e", "status": "#3FA85B", "statusSoft": "#9ED8A8",
    "background": {"light": "#ffffff", "dark": "#0a0a0a"}, "foreground": {"light": "#171717", "dark": "#ededed"}
  },
  "radius": {"sm": "4px", "md": "6px", "xl": "12px", "2xl": "16px", "3xl": "24px", "card-sm": "20px", "card": "28px", "footerFrame": "30px", "cardLg": "36px", "full": "9999px"},
  "spacing": {"unit": "0.25rem", "gutter": "1.5rem", "gutterMd": "2.5rem", "containerMax": "1280px"},
  "breakpoints": {"sm": "40rem", "md": "48rem", "lg": "64rem", "xl": "80rem", "2xl": "96rem", "ls": "(orientation:landscape) and (max-height:500px) and (max-width:1023px)"},
  "shadow": {"lg": "0 10px 15px -3px rgb(0 0 0/.1), 0 4px 6px -4px rgb(0 0 0/.1)", "glowProgress": "0 0 8px rgba(255,255,255,.45)", "glowKnob": "0 0 10px rgba(255,255,255,.6)"},
  "zIndex": {"hero": 0, "content": 10, "section": 20, "sectionRaised": 30, "wash": 35, "stage": 40, "nav": 50, "preloader": 200, "preloaderTour": 300, "modal": 999, "rotateWarning": 9999},
  "motion": {"easeOut": "cubic-bezier(0,0,.2,1)", "easeDefault": "cubic-bezier(.4,0,.2,1)", "easeSignature": "cubic-bezier(.22,1,.36,1)", "durations": {"fast": "150ms", "base": "300ms", "slow": "500ms", "fade": "700ms"}},
  "type": {
    "h1Hero": {"family": "serif", "size": ["clamp(2.75rem,12vw,4.5rem)", "5rem", "5.64rem"], "leading": "94%", "tracking": "normal", "color": "white"},
    "aboutTile": {"family": "serif", "size": ["1.875rem", "1.875rem", "3.5vw"], "leading": "1.25"},
    "aboutStatement": {"family": "sans", "weight": 400, "size": ["clamp(1.75rem,7vw,2.5rem)", "clamp(1.75rem,7vw,2.5rem)", "5.2vw"], "leading": ["1.05", "1.05", "80%"], "tracking": "-0.045em"},
    "marquee": {"family": "sans", "weight": 500, "size": ["clamp(2.5rem,10vw,8rem)", "clamp(2.5rem,10vw,8rem)", "clamp(3.5rem,7.5vw,8rem)"], "leading": 1, "tracking": "-0.07em"},
    "slideH2": {"family": "sans", "size": ["clamp(2rem,8vw,3.75rem)", "same", "4.4vw"], "leading": 0.95, "tracking": "-0.04em"},
    "transitionHeading": {"family": "serif", "size": "clamp(2.25rem,9vw,8rem)", "leading": "94%", "maxWidth": "15ch"},
    "apHeroH2": {"family": "sans", "size": ["clamp(2.75rem,12vw,5.5rem)", "same", "7vw"], "leading": 0.92, "tracking": "-0.05em"},
    "apTextH2": {"family": "sans", "size": ["clamp(1.75rem,6.5vw,2.75rem)", "same", "2.8vw"], "leading": 0.98, "tracking": "-0.04em"},
    "tourH2": {"family": "sans", "size": ["clamp(2.75rem,12vw,5.5rem)", "same", "7.5vw"], "leading": 0.9, "tracking": "-0.05em"},
    "footerH2": {"family": "serif", "size": ["clamp(3rem,13vw,7rem)", "same", "clamp(2.75rem,8vw,7rem)"], "leading": 0.88, "tracking": "-0.03em", "maxWidth": "12ch"},
    "heroTagline": {"size": ["14px", "16px", "18px"], "leading": "120%"},
    "bodySmall": {"size": ["12px", "14px", "14px"], "leading": 1.5, "tracking": "-0.01em"},
    "eyebrow": {"size": "10px", "tracking": "0.2em", "transform": "uppercase", "leading": 1.5},
    "heroMeta": {"size": ["11px", "14px", "18px"], "tracking": "0.18em", "transform": "uppercase"},
    "pill": {"size": "11px", "tracking": "0.18em", "transform": "uppercase"},
    "navLogo": {"size": "20px", "weight": 500, "leading": 1},
    "navMenu": {"size": "16px", "weight": 700, "tracking": "-0.025em", "transform": "uppercase (items)"}
  },
  "tailwind": {
    "v4Theme": "@theme inline { --font-sans: var(--font-familjen-grotesk); --font-serif: var(--font-instrument-serif); --color-sand:#EDE6D6; --color-ink:#2A2725; --color-night:#1c398e; --color-status:#3FA85B; --color-status-soft:#9ED8A8; } @custom-variant ls (@media (orientation:landscape) and (max-height:500px) and (max-width:1023px));",
    "v3Config": {
      "theme": {
        "extend": {
          "fontFamily": {"sans": ["var(--font-familjen-grotesk)", "sans-serif"], "serif": ["var(--font-instrument-serif)", "serif"]},
          "colors": {"sand": "#EDE6D6", "ink": "#2A2725", "night": "#1c398e", "status": "#3FA85B", "status-soft": "#9ED8A8"},
          "borderRadius": {"card-sm": "20px", "card": "28px", "footer-frame": "30px", "card-lg": "36px"},
          "zIndex": {"wash": "35", "preloader": "200", "preloader-tour": "300", "modal": "999", "rotate": "9999"},
          "transitionTimingFunction": {"signature": "cubic-bezier(0.22,1,0.36,1)"},
          "screens": {"ls": {"raw": "(orientation:landscape) and (max-height:500px) and (max-width:1023px)"}}
        }
      }
    }
  }
}
